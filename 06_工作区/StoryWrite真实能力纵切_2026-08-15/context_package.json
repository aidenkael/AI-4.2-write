      "不把父亲塑造成隐藏巨恶",
      "冲突主要来自生计、家庭旧债、不同人生选择、地方变化和人物自己做出的决定"
    ],
    "open_space": [
      "父亲那笔债真正的用途",
      "姐姐十年前离开的全部原因",
      "姐姐这次回来是否还有未说出口的私人目的",
      "姐妹最终合作、决裂还是形成第三种关系",
      "物流站最终是否保留"
    ]
  },
