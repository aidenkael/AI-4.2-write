# Obsidian 本地配置（不上传）
.obsidian/

# 敏感文件
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
secrets.json
*.kdbx

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# 依赖与缓存
node_modules/
venv/
.venv/
__pycache__/
*.sqlite
*.sqlite3
*.db
*.bak
*.log

# WorkBuddy 项目数据（非小说内容，不上传）
.workbuddy/

# 大型工具/二进制（不上传 GitHub：pandoc.exe 超 100MB 限制；本地保留）
05_Skills与自动化/pandoc/

# 原始素材不传 GitHub（本地保留，避免上传受版权保护的小说/资料）
01_原始素材/**/*.epub
01_原始素材/**/*.txt
01_原始素材/**/*.zip
01_原始素材/**/*.pdf
01_原始素材/**/*.azw3
01_原始素材/**/*.mobi

# SourcePrepare 合集识别 manifest（Local Only）
01_原始素材/**/collection_manifest.json

# SourcePrepare 本地工作区（运行时生成，含原著派生正文；不上传）
06_工作区/SourcePrepare/

# MethodPrepare 本地工作区（方法素材确定性预处理产物；不上传）
06_工作区/MethodPrepare/

# BookDistill / MethodDistill request-scoped 蒸馏 staging（§9：Agent 只写此处；
# 未定稿/失败/取消产物绝不进入正式 02；定稿后受控发布到 02 并清理 staging；Local Only）
06_工作区/BookDistill/
06_工作区/MethodDistill/

# 临时脚本/调查产物（Local Only，可删除）
06_工作区/tmp/

# 应用开发临时产物（UI、接口、pywebview、Agent 接入等；Local Only）
06_工作区/应用开发/

# 执行审计记录（验证式可观测性数据；Local Only，可删除）
06_工作区/运行审计/

# 07_工作台应用 前端构建产物（npm run build 生成）
07_工作台应用/ui/dist/

# TypeScript 增量构建信息（tsc -b 生成）
*.tsbuildinfo

# BookDistill Observer discovery staging（正式长期资产由 evidence/BKP 收敛后保存）
02_素材知识库/*/discovery/

# 杂项
*.url
_move_results.json
