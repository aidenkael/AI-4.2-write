{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/features/tasks/taskModel.ts",
    "src/features/settings/settingsSummary.ts",
    "src/features/storyMap/storyMapModel.ts",
    "src/features/presentation/authorPresentation.ts",
    "src/features/projectData/mutationSettlement.ts",
    "src/features/foundation/recordEditors.tsx"
  ]
}
